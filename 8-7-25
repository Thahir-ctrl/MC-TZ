from mcp.server.fastmcp import FastMCP
import requests
from bs4 import BeautifulSoup
import re

mcp = FastMCP("PCIeUpdater")

@mcp.tool()
def update_pcie_block(ref_file: str, new_file: str, module: str = "pcie") -> str:
    """Update PCIe block in new DTSI file based on intranet data"""

    # Step 1: Extract PCIe from ref file
    with open(ref_file) as f:
        ref_text = f.read()
    match = re.search(rf"({module}.*?}};)", ref_text, re.S)
    if not match:
        return "Module not found"
    block = match.group(1)

    # Step 2: Extract reg/interrupt/clock
    reg = re.search(r"reg\s*=\s*<([^>]+)>", block).group(1)
    intr = re.search(r"interrupts\s*=\s*<([^>]+)>", block).group(1)
    clk = re.search(r"clocks\s*=\s*<([^>]+)>", block).group(1)

    # Step 3: Query intranet
    def fetch_from_intranet(key):
        url = f"http://www.intel.../lookup?name={key}"
        resp = requests.get(url)
        soup = BeautifulSoup(resp.text, "html.parser")
        return soup.find("span", {"id": "new_value"}).text

    reg_new = fetch_from_intranet(reg)
    intr_new = fetch_from_intranet(intr)
    clk_new = fetch_from_intranet(clk)

    # Step 4: Replace values
    new_block = block.replace(reg, reg_new).replace(intr, intr_new).replace(clk, clk_new)

    # Step 5: Insert into new DTSI
    with open(new_file) as f:
        new_text = f.read()
    new_text = re.sub(rf"({module}.*?}};)", new_block, new_text, flags=re.S)

    with open(new_file, "w") as f:
        f.write(new_text)

    return "PCIe block updated successfully"
