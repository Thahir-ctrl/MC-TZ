def parse_dtsi_to_tree(file_path):
    with open(file_path) as f:
        lines = f.readlines()

    stack = []
    root = {"children": []}
    current = root

    for line in lines:
        stripped = line.strip()

        if stripped.endswith("{"):
            # Start of a node
            label = stripped.split(":")[0].strip() if ":" in stripped else None
            node_name = stripped.split("{")[0].strip()
            new_node = {"label": label, "name": node_name, "props": {}, "children": []}
