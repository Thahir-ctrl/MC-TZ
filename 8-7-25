            stack.append(current)
            current = new_node

        elif stripped == "};":
            # End of a node
            current = stack.pop()

        elif "=" in stripped and not stripped.startswith("/"):
            # Property line
            key, val = [x.strip(" ;") for x in stripped.split("=", 1)]
            current["props"][key] = val

    return root
