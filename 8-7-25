from mcp.server.fastmcp import FastMCP
import requests
from bs4 import BeautifulSoup
import re

mcp = FastMCP("PCIeMigrator")

@mcp.tool()
def migrate_pcie(ref_file: str, new_file: str) -> str:
    """Migrate PCIe registers from 12th to 13th gen using intranet data"""

    # 1. Extract PCIe block from ref file
    with open(ref_file) as f:
        ref_text = f.read()
    match = re.search(r"(pcie.*?};)", ref_text, re.S)
    if not match:
        return "PCIe block not found"
    block = match.group(1)

    # 2. Extract registers
    reg = re.search(r"reg\s*=\s*<([^>]+)>", block).group(1)

    # 3. Query intranet
    def intranet_lookup(old_val):
        # Step A: Search 12th gen
        resp = requests.post("http://www.intel.categories.com/search12",
                             data={"query": old_val})
        soup = BeautifulSoup(resp.text, "html.parser")
        reg_name = soup.find("span", {"id": "reg_name"}).text

        # Step B: Search 13th gen
        resp2 = requests.post("http://www.intel.categories.com/search13",
                              data={"query": reg_name})
        soup2 = BeautifulSoup(resp2.text, "html.parser")
        new_val = soup2.find("span", {"id": "reg_number"}).text

        return new_val

    reg_new = intranet_lookup(reg)

    # 4. Replace in new file
    with open(new_file) as f:
        new_text = f.read()
    new_text = re.sub(r"(pcie.*?};)", block.replace(reg, reg_new),
                      new_text, flags=re.S)
    with open(new_file, "w") as f:
        f.write(new_text)

    return f"PCIe block migrated: reg {reg} → {reg_new}"
