from playwright.sync_api import sync_playwright
import re

def parse_dtsi(file_path, module="pcie"):
    with open(file_path) as f:
        text = f.read()
    match = re.search(rf"({module}.*?}};)", text, re.S)
    if not match:
        raise ValueError(f"{module} block not found")
    block = match.group(1)
    regs = re.findall(r"reg\s*=\s*<([^>]+)>", block)
    return block, regs

def scrape_registers(page):
    # Example: get all rows in a register table
    rows = page.query_selector_all("table#reg_table tr")
    reg_map = {}
    for row in rows[1:]:  # skip header
        cols = row.query_selector_all("td")
        if len(cols) >= 2:
            name = cols[0].inner_text().strip()
            value = cols[1].inner_text().strip()
            reg_map[name] = value
    return reg_map

def migrate_pcie(ref_file, new_file):
    block, regs = parse_dtsi(ref_file, "pcie")
    anchor_reg = regs[0]

    with sync_playwright() as p:
        context = p.chromium.launch_persistent_context(
            user_data_dir="C:/Users/Thahir/AppData/Local/Microsoft/Edge/User Data",
            channel="msedge",
            headless=True
        )
        page = context.new_page()
        page.goto("http://www.intel.categories.com")

        # JS scroll to select 12th Gen
        page.evaluate("document.querySelector('#ic_scroll').scrollTo(0, 300)")  
        page.click("text=12th Gen")

        # Go to SWI
        page.click("text=SWI")

        # Search with anchor register
        page.fill("#search_box", anchor_reg)
        page.click("#search_button")
        page.wait_for_selector("table#reg_table")

        old_regs = scrape_registers(page)

        # Switch to 13th Gen
        page.evaluate("document.querySelector('#ic_scroll').scrollTo(0, 600)")  
        page.click("text=13th Gen")
        page.click("text=SWI")
        page.fill("#search_box", list(old_regs.keys())[0])
        page.click("#search_button")
        page.wait_for_selector("table#reg_table")

        new_regs = scrape_registers(page)
        context.close()

    # Build mapping by register name
    mapping = {}
    for name, old_val in old_regs.items():
        if name in new_regs:
            mapping[old_val] = new_regs[name]

    # Update new DTSI
    with open(new_file) as f:
        text = f.read()
    for old, new in mapping.items():
        text = text.replace(old, new)
    with open(new_file, "w") as f:
        f.write(text)

    return f"Migrated {len(mapping)} registers successfully."
