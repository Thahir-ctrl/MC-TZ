import re

def parse_dtsi(dtsi_path, module):
    with open(dtsi_path) as f:
        text = f.read()
    # extract pcie block
    match = re.search(rf"({module}.*?}};)", text, re.S)
    if not match:
        raise ValueError(f"{module} block not found")
    block = match.group(1)
    regs = re.findall(r"reg\s*=\s*<([^>]+)>", block)
    return block, regs

def lookup_register(old_val, old_gen="12th", new_gen="13th"):
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        page = browser.new_page()
        page.goto("http://www.intel.categories.com")

        # Select 12th gen
        page.select_option("#ic_selector", old_gen)
        page.fill("#search_box", old_val)
        page.click("#search_button")
        page.wait_for_selector("#result_reg_name")
        reg_name = page.text_content("#result_reg_name")

        # Switch to 13th gen
        page.select_option("#ic_selector", new_gen)
        page.fill("#search_box", reg_name)
        page.click("#search_button")
        page.wait_for_selector("#result_reg_number")
        new_val = page.text_content("#result_reg_number")

        browser.close()
        return reg_name.strip(), new_val.strip()

def update_dtsi(new_file, module, mapping):
    with open(new_file) as f:
        text = f.read()
    for old, new in mapping.items():
        text = text.replace(old, new)
    with open(new_file, "w") as f:
        f.write(text)

