# xml_editor.py
import xml.etree.ElementTree as ET

def update_xml(xml_path, updates):
    tree = ET.parse(xml_path)
    root = tree.getroot()

    for key, value in updates.items():
        elem = root.find(key)
        if elem is not None:
            elem.text = str(value)
        else:
            print(f"⚠️ Warning: Tag '{key}' not found in XML.")

    tree.write(xml_path)
    print(f"✅ XML updated at {xml_path}")
