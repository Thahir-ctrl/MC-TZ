# git_handler.py
import subprocess

def run_git_commands(repo_path, commit_message):
    commands = [
        ["git", "-C", repo_path, "add", "."],
        ["git", "-C", repo_path, "commit", "-m", commit_message],
        ["git", "-C", repo_path, "push"]
    ]

    for cmd in commands:
        subprocess.run(cmd, check=True)
    print("✅ Git operations completed successfully.")
