# main.py
import config
from xml_editor import update_xml
from git_handler import run_git_commands

# Step 1: Choose gen_number
print("Choose a gen_number:")
for k, v in config.gen_choices.items():
    print(f"{k}. {v}th gen")

choice = int(input("Enter choice: "))
config.gen_number = config.gen_choices.get(choice)
if not config.gen_number:
    raise ValueError("Invalid choice for gen_number.")

# Step 2: Get IDs from user
config.machine_id = input("Enter machine ID: ")
config.board_number = input("Enter board number: ")
config.rdp_number = input("Enter RDP number: ")

# Step 3: Update XML
xml_path = config.get_version_path()
updates = {
    "machine_id": config.machine_id,
    "board_number": config.board_number,
    "rdp_number": config.rdp_number
}
update_xml(xml_path, updates)

# Step 4: Git commit & push
run_git_commands(config.repo_path, f"Updated config for {config.gen_number}th gen")
